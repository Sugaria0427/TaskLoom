@startmindmap
!include _theme.iuml
<style>
mindmapDiagram {
  node {
    FontName Microsoft YaHei
    FontSize 20
    FontColor #203144
    BackgroundColor #F4F7FA
    LineColor #9AABBB
    RoundCorner 10
    Padding 15
    Margin 13
  }
  rootNode {
    FontSize 30
    FontStyle bold
    BackgroundColor #E4EDF4
    LineColor #4B6B86
  }
  leafNode {
    FontSize 18
    BackgroundColor #FFFFFF
    LineColor #CBD4DD
  }
